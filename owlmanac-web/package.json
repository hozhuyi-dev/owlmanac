{
  "name": "owlmanac-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "wasm": "npm run wasm:star-battle && npm run wasm:sat-lab",
    "wasm:star-battle": "wasm-pack build ../owlmanac-wasm/crates/star-battle-wasm --target web --release --out-dir ../../../owlmanac-web/src/wasm/star-battle",
    "wasm:sat-lab": "wasm-pack build ../owlmanac-wasm/crates/sat-lab-wasm --target web --release --out-dir ../../../owlmanac-web/src/content/posts/from-brute-force-to-cdcl/wasm",
    "notebooks": "node scripts/notebooks.mjs",
    "covers": "node scripts/covers.mjs",
    "predev": "npm run wasm && npm run notebooks",
    "dev": "astro dev",
    "prebuild": "npm run wasm && npm run notebooks",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.1.2",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@observablehq/plot": "^0.6.17",
    "astro": "^7.4.4",
    "comlink": "^4.4.2",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
