---
import PostCover from "@/components/site/PostCover.astro";
import { formatDay, seriesOf, type Post } from "@/core/site/posts";
import { url } from "@/core/site/url";

// One post on the home page: date, series, title, description and topics, its cover at the side. Carries
// what the search reads (data-search, data-tags). The title's link covers the whole row (a stretched
// ::after), and each topic is its own link above it, filtering the list (index.astro).
interface Props {
  post: Post;
  posts: Post[];
  eager?: boolean;
}

const { post, posts, eager } = Astro.props;
const { title, description, pubDate, tags, tools, cover, coverAlt, coverCredit } = post.data;
const series = seriesOf(post, posts);
const searchText = [title, description, ...tags, ...tools, series?.name ?? ""].join(" ").toLowerCase();
---

<li data-search={searchText} data-tags={tags.join("|")}>
  <div class="entry cover-host">
    <time datetime={pubDate.toISOString()}>{formatDay(pubDate)}</time>
    <span class="text">
      {
        series && (
          <span class="eyebrow series">
            <span>{series.name}</span>
            <span class="part">
              Part {series.index + 1} of {series.parts.length}
            </span>
          </span>
        )
      }
      <a class="title" href={url(`posts/${post.id}/`)}>{title}</a>
      <span class="description">{description}</span>
      {
        tags.length > 0 && (
          <span class="tags">
            {tags.map((tag) => (
              <a href={url(`?tag=${encodeURIComponent(tag)}`)} data-tag-link={tag}>
                {tag}
              </a>
            ))}
          </span>
        )
      }
    </span>
    {
      cover && (
        <PostCover src={cover} alt={coverAlt ?? ""} widths={[320, 640]} sizes="(min-width: 40rem) 13rem, 7rem" eager={eager} drawn={!coverCredit} />
      )
    }
  </div>
</li>

<style>
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) minmax(9rem, 13rem);
    gap: 1.5rem;
    align-items: start;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--line);
  }

  time {
    padding-top: 0.4rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .text {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  /* The series and its part, on one line; on a phone the part takes its own line (below). */
  .series {
    color: var(--accent);
  }

  .part::before {
    content: "·";
    margin-inline: 0.5em;
  }

  .title {
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-decoration: none;
    text-wrap: balance;
  }

  /* The title's link covers the row; the row is outlined when it has focus. */
  .title::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 0.25rem;
  }

  .title:focus-visible {
    outline: none;
  }

  .title:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .entry:hover:not(:has(.tags a:hover)) .title,
  .title:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .description {
    display: -webkit-box;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.95rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  /* Topics sit above the row's link, so a click filters by the topic instead of opening the post. Each is
     at least 24px tall to tap (WCAG's minimum target), without spacing the row out (the negative margin). */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.9rem;
    margin-block: -0.2rem;
    font-size: 0.78rem;
  }

  .tags a {
    position: relative;
    z-index: 1;
    min-height: 1.5rem;
    padding-block: 0.2rem;
    color: var(--muted);
    text-decoration: none;
  }

  .tags a:hover,
  .tags a:focus-visible {
    color: var(--accent);
    text-decoration: underline;
  }

  /* A phone: the date over the title, a small cover at the side, the series' part on its own line. Topics
     stay: the chips above scroll sideways there, so a post's own are the quickest way to its topic. */
  @media (max-width: 40rem) {
    .entry {
      grid-template-columns: minmax(0, 1fr) 7rem;
      gap: 0.3rem 1rem;
      padding-block: 1.1rem;
    }

    time {
      grid-row: 1;
      padding: 0;
      font-size: 0.8rem;
    }

    .text {
      grid-row: 2;
    }

    .entry :global(.cover) {
      grid-column: 2;
      grid-row: 1 / span 2;
      margin-top: 0.2rem;
    }

    .title {
      font-size: 1.25rem;
    }

    .series {
      display: grid;
    }

    .part::before {
      content: none;
    }

    .description {
      font-size: 0.875rem;
    }
  }
</style>
