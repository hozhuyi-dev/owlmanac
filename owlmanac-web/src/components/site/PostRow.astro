---
import PostCover from "@/components/site/PostCover.astro";
import { formatDay, seriesOf, type Post } from "@/core/site/posts";
import { url } from "@/core/site/url";

// One post on the home page: date, series, title, description and topics, its cover at the side. Carries
// what the search reads (data-search, data-tags).
interface Props {
  post: Post;
  posts: Post[];
  eager?: boolean;
}

const { post, posts, eager } = Astro.props;
const { title, description, pubDate, tags, tools, cover, coverAlt } = post.data;
const series = seriesOf(post, posts);
const searchText = [title, description, ...tags, ...tools, series?.name ?? ""].join(" ").toLowerCase();
---

<li data-search={searchText} data-tags={tags.join("|")}>
  <a class="entry" href={url(`posts/${post.id}/`)}>
    <time datetime={pubDate.toISOString()}>{formatDay(pubDate)}</time>
    <span class="text">
      {series && <span class="eyebrow series">{series.name} · Part {series.index + 1} of {series.parts.length}</span>}
      <span class="title">{title}</span>
      <span class="description">{description}</span>
      {tags.length > 0 && <span class="tags">{tags.join(" · ")}</span>}
    </span>
    {cover && <PostCover src={cover} alt={coverAlt ?? ""} widths={[320, 640]} sizes="(min-width: 40rem) 13rem, 7rem" eager={eager} />}
  </a>
</li>

<style>
  .entry {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) minmax(9rem, 13rem);
    gap: 1.5rem;
    align-items: start;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--line);
    color: var(--fg);
    text-decoration: none;
  }

  time {
    padding-top: 0.4rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .text {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .series {
    color: var(--accent);
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .entry:hover .title,
  .entry:focus-visible .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .description {
    display: -webkit-box;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.95rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .tags {
    color: var(--muted);
    font-size: 0.78rem;
  }

  /* A phone: the date over the title, a small cover at the side, no topics (the chips above have them). */
  @media (max-width: 40rem) {
    .entry {
      grid-template-columns: minmax(0, 1fr) 7rem;
      gap: 0.3rem 1rem;
      padding-block: 1.1rem;
    }

    time {
      grid-row: 1;
      padding: 0;
      font-size: 0.8rem;
    }

    .text {
      grid-row: 2;
    }

    .entry :global(.cover) {
      grid-column: 2;
      grid-row: 1 / span 2;
      margin-top: 0.2rem;
    }

    .title {
      font-size: 1.25rem;
    }

    .description {
      font-size: 0.875rem;
    }

    .tags {
      display: none;
    }
  }
</style>
