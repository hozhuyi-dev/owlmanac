---
import Icon from "@/components/site/Icon.astro";
import type { Series } from "@/core/site/posts";
import { url } from "@/core/site/url";

// A post's series, last in its contents (TableOfContents), after the sections and actions, which are used
// more: which part this is, opening to every part. Wide: a line that opens in place. A phone: an icon at the
// bar's end, after the actions, opening a menu that drops from the bar at the right edge and follows it. The
// browser closes the menu on Escape or a tap outside.
interface Props {
  series: Series;
}

const { series } = Astro.props;
const part = `Part ${series.index + 1} of ${series.parts.length}`;
const parts = series.parts.map((post, i) => ({
  title: post.data.title,
  href: url(`posts/${post.id}/`),
  current: i === series.index,
}));
---

<details class="series-nav">
  <summary>
    <span class="eyebrow">{part}</span>
    <span class="name">{series.name}</span>
  </summary>
  <ol>
    {parts.map((part) => (
      <li>{part.current ? <span aria-current="page">{part.title}</span> : <a href={part.href}>{part.title}</a>}</li>
    ))}
  </ol>
</details>

<button type="button" class="series-button" popovertarget="series-menu" title={`${part}: ${series.name}`}>
  <Icon name="series" size={18} />
  <span class="visually-hidden">{part}: {series.name}</span>
</button>
<div id="series-menu" class="series-menu" popover>
  <p class="eyebrow">{part}</p>
  <p class="name">{series.name}</p>
  <ol>
    {parts.map((part) => (
      <li>{part.current ? <span aria-current="page">{part.title}</span> : <a href={part.href}>{part.title}</a>}</li>
    ))}
  </ol>
</div>

<script>
  const menu = document.querySelector<HTMLElement>("#series-menu");
  const bar = document.querySelector<HTMLElement>(".series-button")?.closest("nav");
  // Hung under the bar, against the screen. The bar sticks once scrolled to, and scrolls with the page
  // before then, so while the menu is open it follows the bar's foot.
  const follow = () => menu?.style.setProperty("--top", `${bar?.getBoundingClientRect().bottom ?? 0}px`);
  menu?.addEventListener("beforetoggle", (event) => {
    if ((event as ToggleEvent).newState === "open") follow();
  });
  addEventListener("scroll", () => menu?.matches(":popover-open") && follow(), { passive: true });
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => menu.hidePopover()));
</script>

<style>
  /* Wide: under the sections and actions, set off as the actions are. */
  .series-nav {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  :global(.toc > ul:empty) + .series-nav {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  summary {
    display: grid;
    gap: 0.15rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
  }

  .name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.3;
  }

  summary .name::after {
    content: " ▾";
    color: var(--muted);
    font-size: 0.8em;
  }

  [open] summary .name::after {
    content: " ▴";
  }

  ol {
    display: grid;
    gap: 0.3rem;
    margin: 0.6rem 0 0;
    padding-left: 1.25rem;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  ol ::marker {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  a {
    color: var(--fg);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  [aria-current] {
    color: var(--muted);
  }

  .series-button {
    display: none;
  }

  /* A phone: the icon at the bar's end, and its menu dropping from the bar at the right edge. */
  @media (max-width: 63.99rem) {
    .series-nav {
      display: none;
    }

    .series-button {
      position: relative;
      display: grid;
      flex: none;
      place-items: center;
      align-self: stretch;
      width: 2.5rem;
      margin-right: calc(var(--gutter) - 0.75rem);
      padding: 0;
      border: 0;
      background: none;
      color: var(--muted);
      cursor: pointer;
    }

    .series-button:hover,
    .series-button:has(+ .series-menu:popover-open) {
      color: var(--accent);
    }

    /* A short rule between it and the sections, unless the post's actions come first with theirs. */
    .series-button::before {
      content: "";
      position: absolute;
      inset: 0.75rem auto 0.75rem 0;
      border-left: 1px solid var(--line);
    }

    :global(.actions) ~ .series-button::before {
      display: none;
    }

    .series-menu {
      position: fixed;
      inset: var(--top, 3rem) var(--gutter) auto auto;
      width: min(24rem, calc(100vw - 2 * var(--gutter)));
      margin: 0;
      padding: 0.9rem 1.1rem 1rem;
      border: 1px solid var(--line);
      border-top: 0;
      border-radius: 0 0 0.5rem 0.5rem;
      background: var(--bg);
      color: var(--fg);
      box-shadow: 0 8px 24px color-mix(in srgb, #000 18%, transparent);
    }

    .series-menu .name {
      margin-top: 0.15rem;
    }

    .series-menu ol {
      gap: 0.1rem;
      font-size: 0.95rem;
    }

    .series-menu li > * {
      display: block;
      padding-block: 0.35rem;
    }
  }
</style>
