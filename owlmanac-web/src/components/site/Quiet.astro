---
import { artSvg, firstQuip, TIMES, type Pool } from "@/core/site/owl-art";

// A quiet moment (nothing found, a missing page, something loading or broken): a drawing and a quip,
// then the plain explanation in the slot. It has a night face and a day face, and the theme shows one
// (.by-night, .by-day). Built with each pool's first quip; a script picks one at random on each visit.
// `busy` drawings draw themselves.
interface Props {
  pool: Pool;
}

const { pool } = Astro.props;
---

<div class:list={["quiet", `quiet-${pool}`]} data-pool={pool}>
  {
    TIMES.map((time) => {
      const { quip, art } = firstQuip(pool, time);
      return (
        <div class:list={["quiet-face", `by-${time}`]} data-time={time}>
          <span class="quiet-art" set:html={artSvg(art, 64, { draw: pool === "busy" })} />
          <p class="quiet-quip">{quip}</p>
        </div>
      );
    })
  }
  <div class="quiet-text"><slot /></div>
</div>

<script>
  import { artSvg, quipFor, type Pool, type Time } from "@/core/site/owl-art";

  for (const el of document.querySelectorAll<HTMLElement>(".quiet[data-pool]")) {
    const pool = el.dataset.pool as Pool;
    for (const face of el.querySelectorAll<HTMLElement>(".quiet-face")) {
      const { quip, art } = quipFor(pool, face.dataset.time as Time);
      face.querySelector(".quiet-quip")!.textContent = quip;
      face.querySelector(".quiet-art")!.innerHTML = artSvg(art, 64, { draw: pool === "busy" });
    }
  }
</script>

<style>
  .quiet {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    color: var(--muted);
  }

  /* A face's drawing and quip sit in the quiet moment's own grid. */
  .quiet-face {
    display: contents;
  }

  .quiet-broken .quiet-art {
    color: var(--danger);
  }

  .quiet-quip {
    margin: 0.5rem 0 0;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.25;
  }

  .quiet-text :global(p) {
    margin: 0;
  }
</style>
