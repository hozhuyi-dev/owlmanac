---
import { artSvg, firstQuip, type Pool } from "@/core/site/owl-art";

// A quiet moment (nothing found, a missing page, something loading or broken): a drawing and a quip,
// then the plain explanation in the slot. Built with the pool's first quip; a script picks one at random
// on each visit. `busy` drawings draw themselves.
interface Props {
  pool: Pool;
}

const { pool } = Astro.props;
const { quip, art } = firstQuip(pool);
---

<div class:list={["quiet", pool]} data-pool={pool}>
  <span class="quiet-art" set:html={artSvg(art, 64, { draw: pool === "busy" })} />
  <p class="quiet-quip">{quip}</p>
  <div class="quiet-text"><slot /></div>
</div>

<script>
  import { artSvg, quipFor, type Pool } from "@/core/site/owl-art";

  for (const el of document.querySelectorAll<HTMLElement>(".quiet[data-pool]")) {
    const pool = el.dataset.pool as Pool;
    const { quip, art } = quipFor(pool);
    el.querySelector(".quiet-quip")!.textContent = quip;
    el.querySelector(".quiet-art")!.innerHTML = artSvg(art, 64, { draw: pool === "busy" });
  }
</script>

<style>
  .quiet {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    color: var(--muted);
  }

  .quiet.broken .quiet-art {
    color: var(--danger);
  }

  .quiet-quip {
    margin: 0.5rem 0 0;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.25;
  }

  .quiet-text :global(p) {
    margin: 0;
  }
</style>
