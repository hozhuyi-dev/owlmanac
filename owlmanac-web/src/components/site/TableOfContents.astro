---
import type { MarkdownHeading } from "astro";

// A post's contents. Wide screens: a column of sections (h2) with their subsections (h3). A phone: a bar
// of sections only, scrolling sideways, with a line along its foot for how far through the post you are.
// Either way it marks the section being read. Its slot is for a control the post keeps in reach (a
// notebook's "Show code"): under the list, or at the bar's end, outside what scrolls.
interface Props {
  headings: MarkdownHeading[];
  /** What the contents cover, for the bar's progress: the post's <article>, or a notebook's <iframe>,
      whose headings are then found inside it (it shares the page's origin, and the page scrolls it). */
  within?: string;
}

const { headings, within = "article" } = Astro.props;
const sections: (MarkdownHeading & { children: MarkdownHeading[] })[] = [];
for (const heading of headings) {
  if (heading.depth === 2) sections.push({ ...heading, children: [] });
  else if (heading.depth === 3) sections.at(-1)?.children.push(heading);
}
---

{
  sections.length > 0 && (
    <nav class="toc" aria-label="On this page" data-within={within}>
      <h2 class="eyebrow">On this page</h2>
      <ul>
        {sections.map((section) => (
          <li>
            <a href={`#${section.slug}`}>
              {/* Sized for the bolder current label, so marking it never changes its width. */}
              <span class="label" data-text={section.text}>
                {section.text}
              </span>
            </a>
            {section.children.length > 0 && (
              <ul>
                {section.children.map((child) => (
                  <li>
                    <a href={`#${child.slug}`}>{child.text}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      {
        Astro.slots.has("default") && (
          <div class="extra">
            <slot />
          </div>
        )
      }
      <span class="progress" aria-hidden="true" />
    </nav>
  )
}

<script>
  // Scroll spy: marks the section being read, and its parent section, as current.
  //
  // A link in the contents is a jump (as bizzy's useActiveSection): the section jumped to is current at
  // once and stays so while the page scrolls there, so the sections passed on the way don't flicker
  // through the list, or swing the phone's bar. Once the page is still: if the heading landed near the top
  // it stays current until the reader scrolls (a short section near the end stops below the reading line,
  // and shouldn't hand over to the last one); if the reader cut the jump short, reading resumes there.
  //
  // A notebook's headings are inside its frame, which the page scrolls (it's grown to the notebook's
  // height). They're found there as the notebook renders, measured from the frame's top, and jumped to by
  // scrolling the page; the browser can't follow a link to them by itself, so this does on load and Back.
  const toc = document.querySelector<HTMLElement>(".toc");
  const list = toc?.querySelector<HTMLElement>(":scope > ul");
  const progress = toc?.querySelector<HTMLElement>(".progress");
  const links = [...(toc?.querySelectorAll<HTMLAnchorElement>("a") ?? [])];
  const ids = links.map((link) => decodeURIComponent(link.hash.slice(1)));
  const body = toc ? document.querySelector<HTMLElement>(toc.dataset.within!) : null;
  const notebook = body instanceof HTMLIFrameElement ? body : null;
  const bar = matchMedia("(max-width: 63.99rem)");
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
  // How long the page must be still before a jump counts as landed.
  const SETTLE_MS = 150;
  let frame = 0;
  let jumping = false;
  let jumpedTo: HTMLElement | null = null;
  let settle = 0;

  /** A link's heading: in the page, or in the notebook's frame once it has rendered. */
  function target(i: number): HTMLElement | null {
    return (notebook ? notebook.contentDocument : document)?.getElementById(ids[i]) ?? null;
  }

  /** Where a heading is on the screen. */
  function top(heading: HTMLElement): number {
    return heading.getBoundingClientRect().top + (notebook?.getBoundingClientRect().top ?? 0);
  }

  /** Scrolls a heading to the top of the screen, below what sticks there. */
  function scrollToHeading(heading: HTMLElement, smooth: boolean) {
    const behavior = smooth && !reduceMotion.matches ? "smooth" : "auto";
    if (!notebook) return heading.scrollIntoView({ behavior, block: "start" });
    // The page's scroll-padding-top, which scrollIntoView would have kept clear.
    const clear = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
    window.scrollTo({ top: scrollY + top(heading) - clear, behavior });
  }

  /** The current heading: the last one above a line a quarter of the way down the screen. */
  function reading(): HTMLAnchorElement | undefined {
    // Short last sections never scroll up to that line, so over the last stretch of the page the line
    // glides to the bottom of the screen: they light up in turn, and the last one at the very end.
    const stretch = (innerHeight * 3) / 4;
    const left = document.documentElement.scrollHeight - innerHeight - scrollY;
    const line = innerHeight / 4 + stretch * Math.max(0, 1 - left / stretch);
    let current = -1;
    links.forEach((_, i) => {
      const heading = target(i);
      if (heading && top(heading) <= line) current = i;
    });
    return links[current];
  }

  /** Marks a link and its parent section current, and brings it into view in the contents. */
  function mark(active: HTMLAnchorElement | undefined) {
    const parent = active?.closest("ul ul")?.closest("li")?.querySelector("a");
    for (const link of links) {
      if (link === active || link === parent) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }
    if (!toc || !list) return;
    if (bar.matches) {
      // Keep the current section (its top-level link) in the middle of the bar.
      const shown = (parent ?? active)?.closest("li");
      if (shown) {
        const left = shown.offsetLeft - (list.clientWidth - shown.offsetWidth) / 2;
        if (Math.abs(list.scrollLeft - left) > 4) list.scrollTo({ left, behavior: reduceMotion.matches ? "auto" : "smooth" });
      }
    } else if (active) {
      // Keep the current link in view when the contents are taller than the column.
      const box = toc.parentElement!;
      const top = active.getBoundingClientRect().top - box.getBoundingClientRect().top + box.scrollTop;
      if (top < box.scrollTop || top > box.scrollTop + box.clientHeight - active.offsetHeight) {
        box.scrollTop = top - box.clientHeight / 2;
      }
    }
  }

  /** How far through the post, along the phone bar's foot. It follows every scroll, jumps included. */
  function showProgress() {
    if (!bar.matches || !body || !progress) return;
    const box = body.getBoundingClientRect();
    progress.style.transform = `scaleX(${Math.min(1, Math.max(0, (innerHeight / 2 - box.top) / box.height))})`;
  }

  function update() {
    frame = 0;
    showProgress();
    if (!jumping) mark(reading());
  }

  // Each scroll during a jump puts off landing until the page is still.
  function holdUntilStill() {
    clearTimeout(settle);
    settle = window.setTimeout(() => {
      jumping = false;
      const landed = jumpedTo ? top(jumpedTo) : -Infinity;
      if (landed < -1 || landed > innerHeight / 2) update();
    }, SETTLE_MS);
  }

  /** Jumps to a link's heading, marking it current on the way. */
  function jump(i: number, smooth: boolean): boolean {
    const heading = target(i);
    if (!heading) return false;
    jumping = true;
    jumpedTo = heading;
    mark(links[i]);
    scrollToHeading(heading, smooth);
    holdUntilStill();
    return true;
  }

  /** In a notebook, follows the address's #section, which the browser can't find in the frame. */
  function followHash(smooth: boolean): boolean {
    const i = ids.indexOf(decodeURIComponent(location.hash.slice(1)));
    return i >= 0 && jump(i, smooth);
  }

  if (toc) {
    for (const [i, link] of links.entries()) {
      link.addEventListener("click", (event) => {
        if (!target(i)) return;
        event.preventDefault();
        history.pushState(null, "", link.hash);
        jump(i, true);
      });
    }
    const schedule = () => (frame ||= requestAnimationFrame(update));
    addEventListener("scroll", () => (jumping && holdUntilStill(), schedule()), { passive: true });
    addEventListener("resize", schedule);
    if (notebook) followNotebook(notebook, schedule);
    update();
  }

  /**
   * A notebook grows as it renders, which moves its headings without a scroll. Opened at a #section, the
   * page follows that heading as the notebook grows above it, until the reader takes over or it settles.
   */
  function followNotebook(notebook: HTMLIFrameElement, schedule: () => void) {
    let following = location.hash.length > 1;
    const stop = () => (following = false);
    for (const type of ["wheel", "touchstart", "keydown", "pointerdown"]) addEventListener(type, stop, { once: true, passive: true });
    setTimeout(stop, 10_000);
    new ResizeObserver(() => {
      if (following) followHash(false);
      schedule();
    }).observe(notebook);
    addEventListener("popstate", () => followHash(true));
  }
</script>

<style>
  h2 {
    margin: 0 0 0.75rem;
  }

  ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  ul ul {
    gap: 0.3rem;
    margin: 0.4rem 0 0 0.2rem;
    padding-left: 0.8rem;
    border-left: 1px solid var(--line);
    font-size: 0.8rem;
  }

  a {
    color: var(--muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--fg);
  }

  a[aria-current="true"] {
    color: var(--fg);
    font-weight: 500;
  }

  .progress {
    display: none;
  }

  .extra {
    margin-top: 1.25rem;
  }

  /* A phone: one row of sections under the header's place, scrolling sideways, and the slot at its end. */
  @media (max-width: 63.99rem) {
    .toc {
      position: relative;
      display: flex;
      align-items: center;
      border-bottom: 1px solid var(--line);
      background: var(--bg);
    }

    .toc > ul {
      flex: 1;
      min-width: 0;
    }

    /* Set off from the sections by a short rule. */
    .extra {
      flex: none;
      margin: 0;
      padding-right: calc(var(--gutter) - 0.6rem);
      border-left: 1px solid var(--line);
      line-height: 1.4;
    }

    h2,
    ul ul {
      display: none;
    }

    .toc > ul {
      display: flex;
      gap: 0.25rem;
      height: var(--contents-height);
      padding-inline: calc(var(--gutter) - 0.6rem);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .toc > ul::-webkit-scrollbar {
      display: none;
    }

    .toc > ul > li {
      display: flex;
      flex: none;
    }

    .toc > ul > li > a {
      display: grid;
      align-content: center;
      padding-inline: 0.6rem;
      white-space: nowrap;
    }

    /* The label and an invisible bold copy share one cell, so the bold current one is no wider. */
    .label {
      display: grid;
    }

    .label::after {
      content: attr(data-text);
      height: 0;
      overflow: hidden;
      font-weight: 500;
      visibility: hidden;
    }

    .progress {
      position: absolute;
      bottom: -1px;
      left: 0;
      display: block;
      width: 100%;
      height: 1px;
      background: var(--accent);
      transform: scaleX(0);
      transform-origin: left;
    }
  }
</style>
