---
import PostCover from "@/components/site/PostCover.astro";
import { nextRead, type Post } from "@/core/site/posts";
import { url } from "@/core/site/url";

// At the end of a post: one post to read next (see nextRead for how it's chosen).
interface Props {
  post: Post;
  posts: Post[];
}

const next = nextRead(Astro.props.post, Astro.props.posts);
---

{
  next && (
    <nav class="next-read" aria-label="Read next">
      <a href={url(`posts/${next.post.id}/`)}>
        {next.post.data.cover && (
          <PostCover
            src={next.post.data.cover}
            alt=""
            widths={[400, 800]}
            sizes="(min-width: 40rem) 16rem, 100vw"
            drawn={!next.post.data.coverCredit}
          />
        )}
        <span class="text">
          <span class="eyebrow">{next.inSeries ? "Next in the series" : "Read next"}</span>
          <span class="title">{next.post.data.title}</span>
          <span class="description">{next.post.data.description}</span>
        </span>
      </a>
    </nav>
  )
}

<style>
  .next-read {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  a {
    display: grid;
    grid-template-columns: minmax(10rem, 16rem) minmax(0, 1fr);
    gap: 1.25rem 1.5rem;
    align-items: center;
    color: var(--fg);
    text-decoration: none;
  }

  .text {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1.2;
    text-wrap: balance;
  }

  a:hover .title,
  a:focus-visible .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .description {
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 40rem) {
    a {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
