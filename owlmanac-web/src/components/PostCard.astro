---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "@/lib/posts";
import { url } from "@/lib/url";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, cover, coverAlt } = post.data;
---

<a class="card" href={url(`posts/${post.id}/`)}>
  {cover && <Image src={cover} alt={coverAlt ?? ""} widths={[400, 800]} sizes="(min-width: 48rem) 20rem, 100vw" />}
  <h3>{title}</h3>
  <p class="description">{description}</p>
  {
    tags.length > 0 && (
      <ul class="tags">
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
  <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    color: var(--fg);
    text-decoration: none;
  }

  img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  h3 {
    margin: 0;
    font-size: 1.2rem;
    transition: color 0.15s;
  }

  .card:hover h3 {
    color: var(--accent);
    text-decoration: underline;
  }

  .description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    margin: 0;
    color: var(--muted);
    font-size: 0.925rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.15rem 0.45rem;
    border-radius: 0.375rem;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 500;
  }

  time {
    margin-top: auto;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
</style>
