---
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import PostLayout from "@/layouts/PostLayout.astro";
import { notebookHeadings } from "@/core/site/notebook-headings";
import Icon from "@/components/site/Icon.astro";
import { artSvg } from "@/core/site/owl-art";
import type { Post } from "@/core/site/posts";

// A notebook post: a post (PostLayout) whose body is its marimo notebook, a WASM export served beside the
// page (notebook/), in the post's column. Its contents are the export's headings. The page and notebook
// share an origin, so the frame grows to the notebook's height and the page scrolls as one.
interface Props {
  post: Post;
}

const { post } = Astro.props;
// The export is generated (npm run notebooks); without it the frame would load the site's own 404 page.
const exportPath = join(process.cwd(), "src/content/posts", post.id, "notebook", "index.html");
const exported = existsSync(exportPath);
const headings = exported ? notebookHeadings(readFileSync(exportPath, "utf8")) : [];
const missing = import.meta.env.DEV
  ? "This notebook hasn't been exported yet: run npm run notebooks in owlmanac-web, then reload."
  : "This notebook couldn't be loaded. Try reloading the page.";
---

<PostLayout post={post} headings={headings} meta="A notebook, run in your browser" within="iframe.notebook">
  {
    exported && (
      <button slot="contents" type="button" class="action code-toggle" aria-pressed="false" title="Show code">
        <Icon name="code" size={16} />
        <span class="word">Show code</span>
      </button>
    )
  }
  <p class="notebook-missing figure-status failed" hidden={exported}>{missing}</p>
  {
    exported && (
      <>
        <iframe class="notebook" src="notebook/" title={post.data.title} />
        <div class="notebook-toast" role="status" aria-live="polite" data-state="loading">
          <span class="owl" set:html={artSvg("owl", 28, { draw: true })} />
          <span class="text">Charts are ready. Controls will work shortly.</span>
        </div>
      </>
    )
  }
</PostLayout>

<script>
  import { owlMarkSvg } from "@/core/site/owl-art";

  const frame = document.querySelector<HTMLIFrameElement>("iframe.notebook");

  // marimo scrolls inside #App, which fills the frame. Growing the frame to #App's content height lets
  // the page scroll instead, so there's one scrollbar and the site's footer follows the notebook.
  function fit(app: HTMLElement) {
    const content = [...app.children].reduce((bottom, child) => {
      const box = child.getBoundingClientRect();
      return Math.max(bottom, box.bottom - app.getBoundingClientRect().top + app.scrollTop);
    }, 0);
    if (content > 0 && frame) frame.style.height = `${Math.ceil(content)}px`;
  }

  function attach() {
    // The export shows the frame once it has painted (scripts/notebooks.mjs); by load it surely has.
    frame?.setAttribute("data-painted", "");
    const doc = frame?.contentDocument;
    if (!doc) return;
    // Not a marimo export (say a 404, which would show the site inside itself): show the notice instead.
    if (!doc.querySelector("marimo-code")) {
      frame!.remove();
      document.querySelector(".notebook-toast")?.remove();
      document.querySelector<HTMLElement>(".notebook-missing")!.hidden = false;
      return;
    }
    // #App appears once marimo mounts; then refit whenever any of its content changes size.
    const watch = new MutationObserver(() => {
      const app = doc.getElementById("App");
      if (!app) return;
      watch.disconnect();
      const resize = new ResizeObserver(() => fit(app));
      const observeAll = () => [...app.children].forEach((child) => resize.observe(child));
      observeAll();
      new MutationObserver(observeAll).observe(app, { childList: true });
      fit(app);
    });
    watch.observe(doc.body, { childList: true, subtree: true });
    followKernel(doc);
  }

  // The export shows outputs embedded at build time; inputs work only once Python has loaded and rerun the
  // cells. marimo marks that run (pinned version): the connection opens, then a loading indicator and
  // "stale" outputs appear while cells rerun, and clear when they finish.
  const toast = document.querySelector<HTMLElement>(".notebook-toast");
  const MESSAGES = {
    loading: "Charts are ready. Controls will work shortly.",
    running: "Almost ready…",
    ready: "Ready: try the controls.",
    slow: "Taking a while. The charts are accurate; controls will follow.",
  };

  function show(state: keyof typeof MESSAGES) {
    if (!toast || toast.dataset.state === state) return;
    toast.dataset.state = state;
    toast.querySelector(".text")!.textContent = MESSAGES[state];
    // While Python loads, the owl draws itself; once the notebook is live, the sketch gives way to the
    // finished mark, still, so nothing in the toast looks busy any more.
    if (state === "ready") toast.querySelector(".owl")!.innerHTML = owlMarkSvg(28);
    if (state === "ready") setTimeout(() => (toast.hidden = true), 4000);
  }

  function followKernel(doc: Document) {
    const started = Date.now();
    let sawRun = false;
    let idleSince = 0;
    const timer = setInterval(() => {
      const open = doc.querySelector('[data-connection-state="OPEN"]');
      const busy = doc.querySelector('[data-testid="loading-indicator"], [title="This output is stale"]');
      if (busy) sawRun = true;
      if (!open || !sawRun) {
        show(Date.now() - started > 120_000 ? "slow" : "loading");
      } else if (busy) {
        idleSince = 0;
        show("running");
      } else if ((idleSince ||= Date.now()) && Date.now() - idleSince > 1000) {
        show("ready");
        clearInterval(timer);
      }
    }, 250);
  }

  // Code starts hidden in a post, so it reads as prose and charts (notebook.css). "Show code", kept in reach
  // in the contents, marks the notebook's <html> with .show-code; nothing reloads, and inputs keep their
  // values. The page scrolls the frame, so the notebook's own menu toggle is a long way down.
  const toggle = document.querySelector<HTMLButtonElement>(".code-toggle");
  toggle?.addEventListener("click", () => {
    const show = toggle.getAttribute("aria-pressed") !== "true";
    toggle.setAttribute("aria-pressed", String(show));
    frame?.contentDocument?.documentElement.classList.toggle("show-code", show);
  });

  // The frame can finish loading before this script runs (a cached visit), so attach now if it has.
  if (frame) {
    const doc = frame.contentDocument;
    if (doc?.readyState === "complete" && doc.URL !== "about:blank") attach();
    else frame.addEventListener("load", attach, { once: true });
  }
</script>

<style>
  /* The post's column; inside posts the notebook drops its own side padding (notebook.css), so its text
     lines up with the title. */
  .notebook {
    display: block;
    width: 100%;
    height: calc(100vh - var(--header-height));
    border: 0;
    background: var(--bg);
  }

  /* Until the notebook has painted in the site's theme (data-painted, set from inside it), the frame shows
     its blank first document, which the browser backs with white on a dark page. Invisible, it keeps its
     size, so nothing moves when it appears. */
  .notebook:not([data-painted]) {
    opacity: 0;
  }

  .notebook-missing {
    padding-block: 2rem;
  }

  /* "Show code" is one of the contents' actions, styled there (TableOfContents): the code icon and its
     word, or the icon alone on a phone; in the accent while code shows. */

  .notebook-toast {
    position: fixed;
    bottom: 1rem;
    left: 50%;
    z-index: 20;
    display: flex;
    gap: 0.6rem;
    align-items: center;
    width: max-content;
    max-width: calc(100vw - 2rem);
    padding: 0.55rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--fg);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--fg) 12%, transparent);
    font-size: 0.875rem;
    transform: translateX(-50%);
  }

  .notebook-toast[hidden] {
    display: none;
  }

  /* The toast's drawing: the owl drawing itself while Python loads, the filled mark once it's live (show). */
  .owl {
    display: grid;
    flex: none;
    color: var(--accent);
  }
</style>
