---
import { Font } from "astro:assets";
import "@/styles/global.css";
import Haunts from "@/components/site/Haunts.astro";
import Icon from "@/components/site/Icon.astro";
import ThemeSwitch from "@/components/site/ThemeSwitch.astro";
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from "@/consts";
import { artUrl, HOURS, owlMarkSvg, QUIPS } from "@/core/site/owl-art";
import { getPosts, haunts } from "@/core/site/posts";
import { url } from "@/core/site/url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = SITE_DESCRIPTION, image } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const aboutHref = url("about/");
const onAbout = Astro.url.pathname.startsWith(aboutHref);
const quips = QUIPS;
const hasHaunts = haunts(await getPosts()).length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <link rel="canonical" href={canonical} />
    <!-- The SVG where it's shown, a PNG tile elsewhere: iOS shows no SVG favicon, and under /owlmanac/ the
         browser's fallback /favicon.ico isn't ours (npm run icons). The PNG's sizes keep Chrome on the SVG. -->
    <link rel="icon" type="image/png" sizes="96x96" href={url("favicon-96.png")} />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <link rel="apple-touch-icon" href={url("apple-touch-icon.png")} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url("rss.xml")} />
    <link rel="sitemap" href={url("sitemap-index.xml")} />
    <meta property="og:type" content={title ? "article" : "website"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="generator" content={Astro.generator} />
    <!-- Fonts: body text and headings are on every page, so their files load at once; code's when used. -->
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-display" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-mono" />
    <!-- Apply a saved theme before first paint, so the page never flashes the other one. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark" || theme === "auto") document.documentElement.dataset.theme = theme;
      } catch {
        // Storage blocked (a private window): the default, dark, stays.
      }
    </script>
    <!-- The quips CSS shows (a chart waiting, a figure's failure), one per visit, night's and day's: the
         theme picks which shows (global.css). -->
    <script is:inline define:vars={{ quips }}>
      const pick = (list) => list[Math.floor(Math.random() * list.length)];
      for (const [time, pools] of Object.entries(quips))
        for (const pool of ["busy", "broken"])
          document.documentElement.style.setProperty(`--${pool}-quip-${time}`, JSON.stringify(pick(pools[pool])));
    </script>
    <style is:inline set:html={`:root{--busy-art:${artUrl("owl")}}`} />
  </head>
  <body>
    <!-- Duotone plates for covers: luminance onto the theme's colours. Covers are drawn on the dark theme's
         charcoal (#2b2b2b, luminance about 1/6), which lands exactly on the page; brighter lines ramp to the
         accent. In light theme the plate inverts to ink on the paper (#f6f4ef). -->
    <svg class="visually-hidden" aria-hidden="true" focusable="false">
      <defs>
        <filter id="duo-dark" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.2126 0.7152 0.0722 0 0 0.2126 0.7152 0.0722 0 0 0.2126 0.7152 0.0722 0 0 0 0 0 1 0" />
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.169 0.169 0.30 0.45 0.60 0.78 0.92" />
            <feFuncG type="table" tableValues="0.169 0.169 0.36 0.58 0.76 0.88 0.97" />
            <feFuncB type="table" tableValues="0.169 0.169 0.38 0.62 0.82 0.92 0.98" />
          </feComponentTransfer>
        </filter>
        <filter id="duo-light" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.2126 0.7152 0.0722 0 0 0.2126 0.7152 0.0722 0 0 0.2126 0.7152 0.0722 0 0 0 0 0 1 0" />
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.965 0.965 0.70 0.40 0.15 0.04 0.02" />
            <feFuncG type="table" tableValues="0.957 0.957 0.86 0.70 0.55 0.42 0.30" />
            <feFuncB type="table" tableValues="0.937 0.937 0.92 0.82 0.72 0.60 0.45" />
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={url()} aria-label={`${SITE_TITLE}, all posts`}>
          <Fragment set:html={owlMarkSvg(36, { asleep: true })} />
          <span class="name">
            <span class="title">{SITE_TITLE}</span>
            <!-- What the owl is up to: night's line or day's, by the theme, beside the mark's day "z z". -->
            <span class="hours">
              <span class="by-night">{HOURS.night[0]}</span><span class="by-day">{HOURS.day[0]}</span>
            </span>
          </span>
        </a>
        <nav aria-label="Site">
          {
            hasHaunts && (
              <button type="button" class="haunts-open wide" popovertarget="haunts">
                Haunts <Icon name="chevron" size={14} />
              </button>
            )
          }
          <a href={aboutHref} aria-current={onAbout ? "page" : undefined}>About</a>
          <ThemeSwitch />
          {
            hasHaunts && (
              <button type="button" class="haunts-open narrow" popovertarget="haunts" aria-label="Haunts" title="Haunts">
                <Icon name="menu" size={22} />
              </button>
            )
          }
        </nav>
        <!-- One line per visit for each, picked as the page is read, once the nav is laid out beside it: only
             from the lines that fit on one line in the room there is, so it never wraps, and it's in place
             before the first paint and never changes in view. The fallback fonts are sized to match the real
             ones, so what fits now still fits when they arrive. -->
        <script is:inline define:vars={{ hours: HOURS }}>
          const box = document.querySelector(".site-header .hours");
          if (box) {
            // With only every line at once in it, the box is as wide as the room the nav leaves.
            const shown = [...box.children];
            shown.forEach((line) => (line.textContent = ""));
            const probe = document.createElement("span");
            probe.className = "probe";
            box.append(probe);
            probe.textContent = Object.values(hours).flat().join(" ");
            const room = box.clientWidth;
            for (const [time, lines] of Object.entries(hours)) {
              const fits = lines.filter((line) => ((probe.textContent = line), probe.offsetWidth <= room));
              const pool = fits.length ? fits : lines;
              shown.find((line) => line.matches(`.by-${time}`)).textContent = pool[Math.floor(Math.random() * pool.length)];
            }
            probe.remove();
          }
        </script>
      </div>
      <Haunts />
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          <span>© {new Date().getFullYear()} {AUTHOR}</span>
          {SOCIAL_LINKS.map((link) => <a href={link.url}>{link.name}</a>)}
          <a href={url("rss.xml")}>RSS</a>
        </p>
      </div>
    </footer>
    <script>
      // A touch screen can't hover, so a cover takes its colours while it crosses the middle of the screen.
      if (matchMedia("(hover: none)").matches && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => entries.forEach((entry) => entry.target.classList.toggle("lit", entry.isIntersecting)),
          { rootMargin: "-40% 0px -40% 0px" },
        );
        document.querySelectorAll(".cover").forEach((cover) => observer.observe(cover));
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    background: var(--bg);
  }

  /* Sticky on wide screens only; on a phone it scrolls away and a post's contents bar takes the top. */
  @media (min-width: 64rem) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 10;
    }
  }

  .site-header .container {
    display: flex;
    gap: 0.75rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-height);
  }

  .brand {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    color: var(--fg);
    font-family: var(--font-display);
    text-decoration: none;
  }

  .brand :global(svg) {
    flex: none;
    display: block;
    margin-top: -0.2rem;
  }

  .brand {
    min-width: 0;
  }

  /* The name, and the owl's hours under it, give way to the nav: the line is picked to fit (above), and
     cut short with an ellipsis only if the screen narrows after. */
  .name {
    display: grid;
    min-width: 0;
  }

  .title {
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  /* The owl's hours, a quiet line under the name, always one line. */
  .hours {
    overflow: hidden;
    color: var(--muted);
    font-size: 0.8rem;
    font-style: italic;
    line-height: 1.3;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* Measures the room, and each line, laid out like the line but unseen. */
  .hours :global(.probe) {
    visibility: hidden;
  }

  nav {
    display: flex;
    flex: none;
    gap: 1.25rem;
    align-items: center;
    font-size: 1rem;
  }

  nav a {
    color: var(--fg);
    text-decoration: none;
    text-decoration-thickness: 1px;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    text-decoration-line: underline;
  }

  .haunts-open {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    cursor: pointer;
  }

  .haunts-open :global(svg) {
    transition: transform 0.15s;
  }

  .haunts-open:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  :global(.site-header:has(.haunts:popover-open)) .haunts-open.wide :global(svg) {
    transform: rotate(180deg);
  }

  /* A phone's ☰: a thumb's size, hanging into the gutter so its tap reaches the edge. */
  .haunts-open.narrow {
    display: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: -0.5rem -0.6rem -0.5rem -0.35rem;
  }

  @media (max-width: 47.99rem) {
    .haunts-open.wide {
      display: none;
    }

    .haunts-open.narrow {
      display: grid;
    }
  }

  /* A phone keeps the same layout, with the theme switch down to one button (ThemeSwitch) and Haunts behind
     a ☰: the line under the name has the room left beside the nav, and is picked to fit it. Down to 320px. */
  @media (max-width: 40rem) {
    .site-header .container {
      column-gap: 0.75rem;
      padding-block: 0.6rem;
    }

    .hours {
      font-size: 0.75rem;
    }

    nav {
      gap: 0.75rem;
    }
  }

  main {
    min-height: 70vh;
  }

  .site-footer {
    margin-top: 5rem;
  }

  .site-footer p {
    display: flex;
    margin: 0;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--fg);
    text-decoration: underline;
  }
</style>
