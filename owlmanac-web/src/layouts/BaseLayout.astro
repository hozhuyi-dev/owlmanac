---
import { Font } from "astro:assets";
import "@/styles/global.css";
import ThemeSwitch from "@/components/site/ThemeSwitch.astro";
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from "@/consts";
import { artUrl, owlMarkSvg, QUIPS } from "@/core/site/owl-art";
import { url } from "@/core/site/url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = SITE_DESCRIPTION, image } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const aboutHref = url("about/");
const onAbout = Astro.url.pathname.startsWith(aboutHref);
const busy = QUIPS.busy;
const broken = QUIPS.broken;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <link rel="canonical" href={canonical} />
    <!-- The SVG where it's shown, a PNG tile elsewhere: iOS shows no SVG favicon, and under /owlmanac/ the
         browser's fallback /favicon.ico isn't ours (npm run icons). The PNG's sizes keep Chrome on the SVG. -->
    <link rel="icon" type="image/png" sizes="96x96" href={url("favicon-96.png")} />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <link rel="apple-touch-icon" href={url("apple-touch-icon.png")} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={url("rss.xml")} />
    <link rel="sitemap" href={url("sitemap-index.xml")} />
    <meta property="og:type" content={title ? "article" : "website"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="generator" content={Astro.generator} />
    <!-- Fonts: body text and headings are on every page, so their files load at once; code's when used. -->
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-display" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-mono" />
    <!-- Apply a saved theme before first paint, so the page never flashes the other one. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark" || theme === "auto") document.documentElement.dataset.theme = theme;
      } catch {
        // Storage blocked (a private window): the default, dark, stays.
      }
    </script>
    <!-- The quips CSS shows (a chart waiting, a figure's failure), one per visit. -->
    <script is:inline define:vars={{ busy, broken }}>
      const pick = (list) => list[Math.floor(Math.random() * list.length)];
      document.documentElement.style.setProperty("--busy-quip", JSON.stringify(pick(busy)));
      document.documentElement.style.setProperty("--broken-quip", JSON.stringify(pick(broken)));
    </script>
    <style is:inline set:html={`:root{--busy-art:${artUrl("owl")}}`} />
  </head>
  <body>
    <!-- Duotone plates for covers: luminance onto the theme's colours. Covers are drawn on the dark theme's
         charcoal (#2b2b2b, luminance about 1/6), which lands exactly on the page; brighter lines ramp to the
         accent. In light theme the plate inverts to ink on white. -->
    <svg class="visually-hidden" aria-hidden="true" focusable="false">
      <defs>
        <filter id="duo-dark" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.2126 0.7152 0.0722 0 0 0.2126 0.7152 0.0722 0 0 0.2126 0.7152 0.0722 0 0 0 0 0 1 0" />
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.169 0.169 0.30 0.45 0.60 0.78 0.92" />
            <feFuncG type="table" tableValues="0.169 0.169 0.36 0.58 0.76 0.88 0.97" />
            <feFuncB type="table" tableValues="0.169 0.169 0.38 0.62 0.82 0.92 0.98" />
          </feComponentTransfer>
        </filter>
        <filter id="duo-light" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.2126 0.7152 0.0722 0 0 0.2126 0.7152 0.0722 0 0 0.2126 0.7152 0.0722 0 0 0 0 0 1 0" />
          <feComponentTransfer>
            <feFuncR type="table" tableValues="1 1 0.70 0.40 0.15 0.04 0.02" />
            <feFuncG type="table" tableValues="1 1 0.86 0.70 0.55 0.42 0.30" />
            <feFuncB type="table" tableValues="1 1 0.92 0.82 0.72 0.60 0.45" />
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={url()} aria-label={`${SITE_TITLE}, all posts`}>
          <Fragment set:html={owlMarkSvg(36)} />
          <span>{SITE_TITLE}</span>
        </a>
        <nav aria-label="Site">
          <a href={aboutHref} aria-current={onAbout ? "page" : undefined}>About</a>
          <ThemeSwitch />
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          <span>© {new Date().getFullYear()} {AUTHOR}</span>
          {SOCIAL_LINKS.map((link) => <a href={link.url}>{link.name}</a>)}
          <a href={url("rss.xml")}>RSS</a>
        </p>
      </div>
    </footer>
    <script>
      // A touch screen can't hover, so a cover takes its colours while it crosses the middle of the screen.
      if (matchMedia("(hover: none)").matches && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => entries.forEach((entry) => entry.target.classList.toggle("lit", entry.isIntersecting)),
          { rootMargin: "-40% 0px -40% 0px" },
        );
        document.querySelectorAll(".cover").forEach((cover) => observer.observe(cover));
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    background: var(--bg);
  }

  /* Sticky on wide screens only; on a phone it scrolls away and a post's contents bar takes the top. */
  @media (min-width: 64rem) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 10;
    }
  }

  .site-header .container {
    display: flex;
    gap: 0.75rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-height);
  }

  .brand {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand :global(svg) {
    display: block;
    margin-top: -0.2rem;
  }

  nav {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    font-size: 1rem;
  }

  nav a {
    color: var(--fg);
    text-decoration: none;
    text-decoration-thickness: 1px;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    text-decoration-line: underline;
  }

  main {
    min-height: 70vh;
  }

  .site-footer {
    margin-top: 5rem;
  }

  .site-footer p {
    display: flex;
    margin: 0;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--fg);
    text-decoration: underline;
  }
</style>
