---
import type { MarkdownHeading } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import NextRead from "@/components/site/NextRead.astro";
import PostMeta from "@/components/site/PostMeta.astro";
import SeriesNav from "@/components/site/SeriesNav.astro";
import TableOfContents from "@/components/site/TableOfContents.astro";
import { getPosts, readingTime, type Post } from "@/core/site/posts";

// A post: its title and meta, then its contents (a column beside the post on wide screens, a sticky bar
// under the title on a phone), the cover and body, and what to read next. A notebook post is laid out
// the same, its notebook in the body's place (NotebookLayout).
interface Props {
  post: Post;
  headings: MarkdownHeading[];
  /** After the date: the reading time, or what kind of post it is. */
  meta?: string;
  /** What the contents cover: see TableOfContents. */
  within?: string;
}

const { post, headings, meta = readingTime(post.body ?? ""), within } = Astro.props;
const posts = await getPosts();
const { title, description, cover, coverAlt, coverCredit, notebook } = post.data;
---

<BaseLayout title={title} description={description} image={cover?.src}>
  <div class="container layout">
    <header class="post-head">
      <h1>{title}</h1>
      <PostMeta post={post} extra={meta} />
      <SeriesNav post={post} posts={posts} />
    </header>
    <aside class="contents">
      {/* A layout's "contents" slot goes into the contents: a control kept in reach (NotebookLayout). */}
      {
        Astro.slots.has("contents") ? (
          <TableOfContents headings={headings} within={within}>
            <slot name="contents" />
          </TableOfContents>
        ) : (
          <TableOfContents headings={headings} within={within} />
        )
      }
    </aside>
    <article>
      {
        cover && (
          <figure class="cover-figure">
            <Image
              class:list={[{ "drawn-cover": !coverCredit }]}
              src={cover}
              alt={coverAlt ?? ""}
              widths={[800, 1600]}
              sizes="(min-width: 44rem) 44rem, 100vw"
              loading="eager"
            />
            {coverCredit && <figcaption>Image credit: {coverCredit}</figcaption>}
          </figure>
        )
      }
      {
        notebook ? (
          <slot />
        ) : (
          <div class="prose">
            <slot />
          </div>
        )
      }
      <NextRead post={post} posts={posts} />
    </article>
  </div>
</BaseLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-top: var(--page-top);
  }

  .post-head,
  article {
    min-width: 0;
    max-width: var(--measure);
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 1.3rem + 2.8vw, 3rem);
    line-height: 1.1;
  }

  /* A phone: the contents are a bar that sticks to the top of the screen, from under the title on. */
  .contents {
    position: sticky;
    top: 0;
    z-index: 5;
    margin-inline: calc(-1 * var(--gutter));
    margin-bottom: 1.5rem;
  }

  /* Wide: the post and its contents side by side, a fixed gap apart, the pair centred, so what room is left
     over falls evenly to either side rather than opening between them. */
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, var(--measure)) minmax(12rem, 15rem);
      gap: 0 4rem;
      justify-content: center;
    }

    .post-head,
    article {
      grid-column: 1;
    }

    /* Wide: a column beside the post, sticking where it starts. */
    .contents {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: start;
      top: calc(var(--header-height) + var(--page-top));
      max-height: calc(100vh - var(--header-height) - var(--page-top) - 1rem);
      margin: 0;
      padding-top: 0.75rem;
      overflow-y: auto;
    }
  }

  .cover-figure {
    margin: 0 0 1.5rem;
  }

  .cover-figure img {
    display: block;
    width: 100%;
    border-radius: 0.5rem;
  }

  .cover-figure figcaption {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.8rem;
    font-style: italic;
  }
</style>
