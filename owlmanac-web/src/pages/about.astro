---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Resume from "@/components/site/Resume.astro";
import { Content as Summary } from "@/content/about.md";
import { EMAIL, SOCIAL_LINKS } from "@/consts";

// About: a short summary (src/content/about.md), ways to get in touch, and the resume (public/resume.pdf).
// Updating either is one file.
---

<BaseLayout title="About">
  <section class="container page">
    <h1 class="visually-hidden">About</h1>
    <div class="summary">
      <Summary />
    </div>
    <p class="contact">
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      {SOCIAL_LINKS.map((link) => <a href={link.url}>{link.name}</a>)}
    </p>
    <Resume />
  </section>
</BaseLayout>

<style>
  /* Opens like the home page: no visible title (the header's About link says where you are), the summary
     at the intro line's place, size and measure. */
  .page {
    padding-top: clamp(1.5rem, 5vw, 3.5rem);
  }

  .summary {
    max-width: 38rem;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.6rem);
    line-height: 1.4;
  }

  .summary :global(p) {
    margin: 0 0 1rem;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
  }
</style>
