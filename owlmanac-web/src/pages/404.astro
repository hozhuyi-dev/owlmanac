---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Quiet from "@/components/site/Quiet.astro";
import { url } from "@/core/site/url";
---

<BaseLayout title="Not found">
  <section class="container page">
    <h1 class="visually-hidden">Page not found</h1>
    <Quiet pool="lost">
      <p>This page doesn't exist, or it has moved. <a href={url()}>Back to the posts</a>.</p>
    </Quiet>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(3rem, 10vw, 6rem);
  }
</style>
